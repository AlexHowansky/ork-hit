# Port the app listens on. A TLS-terminating reverse proxy should sit in front.
PORT=3000

# Public origin the app is served from. Used to build session invite URLs and to
# validate the Origin header on mutating requests. No trailing slash.
APP_ORIGIN=https://ttrpg.example.com

# Set to 1 when a reverse proxy is in front and X-Forwarded-For can be trusted for
# client IPs in rate limiting and logs. Leave unset when Bun is directly exposed.
TRUSTED_PROXY=1

# SQLite database file.
DATABASE_PATH=./data/app.db

# Directory uploaded sheets and images are written to. Must NOT be publicly served.
UPLOAD_DIR=./data/uploads

# debug | info | warn | error
LOG_LEVEL=info

# Set to 1 only for local development over plain HTTP: drops the Secure flag on
# cookies so they work without TLS. Never enable in production.
INSECURE_COOKIES=0
