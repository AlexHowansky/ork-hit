# Port the app listens on. A TLS-terminating reverse proxy should sit in front.
PORT=3000

# Public origin the app is served from. Used to build session invite URLs and to
# validate the Origin header on mutating requests. No trailing slash.
APP_ORIGIN=https://ttrpg.example.com

# Set to 1 when a reverse proxy is in front and X-Forwarded-For can be trusted for
# client IPs in rate limiting and logs. Leave unset when Bun is directly exposed.
TRUSTED_PROXY=1

# SQLite database file.
DATABASE_PATH=./data/app.db

# Directory uploaded sheets and images are written to. Must NOT be publicly served.
UPLOAD_DIR=./data/uploads

# debug | info | warn | error
LOG_LEVEL=info

# Set to 1 only for local development over plain HTTP: drops the Secure flag on
# cookies so they work without TLS. Never enable in production.
INSECURE_COOKIES=0

# How long a player may be disconnected before they are dropped from their
# session, in milliseconds. Covers a reload or a brief network drop; when it
# expires the seat is freed and their character can be claimed by someone else.
PLAYER_GRACE_MS=30000

# The largest an uploaded file may be, in bytes — one ceiling for both character
# sheets and card images. Clamped to 65536-536870912; the default is 10485760
# (10 MB).
UPLOAD_LIMIT_BYTES=10485760

# How much of the window a character sheet is opened over, as a percentage. One
# number sets both dimensions, so the sheet always carries the window's own
# aspect ratio: 90 is nine tenths of it each way, 100 fills the viewport outright.
# Clamped to 10-100; the default is 90.
SHEET_WIDTH_PCT=90

# How strongly a card's picture catches the light as it tilts under the pointer,
# as a percentage of the strength the effect was tuned at. 100 is that tuning and
# 0 turns the highlight off altogether; past about 165 its brightest part is
# already pure white and stops climbing. Clamped to 0-300; the default is 25, a
# glint rather than the gloss the full strength gives.
CARD_SHEEN_PCT=25

# The typeface the names on cards are set in. Both are needed for either to do
# anything: the URL is a stylesheet carrying the font, which often names several
# families, and the family says which of them to draw with.
#
# The URL must be an https stylesheet on fonts.googleapis.com — the page's
# Content-Security-Policy admits that host and no other, so anything else would be
# blocked by the browser, and is refused at startup with a line in the log rather
# than failing silently. Serving a font from elsewhere means widening the CSP in
# src/client/index.html and the host list in src/lib/config.ts together.
#
# The family may contain letters, digits, spaces and hyphens. Unset, or set to
# something unusable, card names keep the interface font.
#
# Note this has each reader's browser fetch the font from Google directly.
CARD_FONT_URL=https://fonts.googleapis.com/css2?family=Rubik+Glitch&display=swap
CARD_FONT_FAMILY=Rubik Glitch
